{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aeron Tools",
  "version": "1.1.2",
  "identifier": "com.aeronlabs.aerontools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Aeron Tools",
        "width": 340,
        "height": 540,
        "minWidth": 340,
        "maxWidth": 340,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "shadow": true,
        "visible": false,
        "windowEffects": {
          "effects": ["popover"],
          "state": "active",
          "radius": 18.0
        }
      },
      {
        "label": "settings",
        "title": "Aeron Tools Settings",
        "url": "index.html?window=settings",
        "width": 620,
        "height": 660,
        "minWidth": 560,
        "minHeight": 500,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
